# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN commit file ".env" (berisi kredensial asli) ke git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=healin_db
DB_USER=postgres
DB_PASSWORD=your_password

# Jika DATABASE_URL diisi, nilai ini akan dipakai langsung dan
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD di atas diabaikan.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/healin_db
